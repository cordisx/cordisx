{
  "name": "cordisx-monorepo",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "files": [
    "packages/cli/dist",
    "packages/cli/package.json",
    "packages/cli/README.md",
    "packages/cli/LICENSE",
    "packages/cli/CORDISX-INDEPENDENT-PLUGIN-EXCEPTION.md",
    "packages/cli/THIRD_PARTY_NOTICES.md",
    "packages/cli/third_party"
  ],
  "bin": {
    "cordisx": "packages/cli/dist/src/cli.js"
  },
  "exports": {
    "./contracts": {
      "types": "./packages/cli/dist/src/contracts.d.ts",
      "default": "./packages/cli/dist/src/contracts.js"
    },
    "./react": {
      "types": "./packages/cli/dist/src/react.d.ts",
      "default": "./packages/cli/dist/src/react.js"
    },
    "./react/jsx-runtime": {
      "types": "./packages/cli/dist/src/react-jsx-runtime.d.ts",
      "default": "./packages/cli/dist/src/react-jsx-runtime.js"
    },
    "./react/jsx-dev-runtime": {
      "types": "./packages/cli/dist/src/react-jsx-dev-runtime.d.ts",
      "default": "./packages/cli/dist/src/react-jsx-dev-runtime.js"
    },
    "./ui": {
      "types": "./packages/cli/dist/src/ui.d.ts",
      "default": "./packages/cli/dist/src/ui.js"
    },
    "./vite": {
      "types": "./packages/cli/dist/src/vite.d.ts",
      "default": "./packages/cli/dist/src/vite.js"
    },
    "./agent-tools": {
      "types": "./packages/cli/dist/src/agent-tools.d.ts",
      "default": "./packages/cli/dist/src/agent-tools.js"
    }
  },
  "bundledDependencies": [
    "@cordisx/schemastery-ui",
    "@cordisx/channel",
    "@cordisx/plugin-cli-proxy-api"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check:clean-dev && npm run typecheck && npm run build && npm test && npm run check:release && npm run check:package && npm run check:installed",
    "check:fast": "npm run lint:staged && npm run typecheck && npm run test:affected",
    "check:clean-dev": "node scripts/check-clean-dev.mjs",
    "check:installed": "node scripts/check-installed-packages.mjs",
    "check:package": "npm run check:package --workspaces --if-present",
    "check:release": "node scripts/check-release-metadata.mjs",
    "checkpoint:local-dev": "vitest run tests/local-development-generation.test.ts tests/cdp.test.ts tests/local-development-manager.integration.test.ts tests/cli-run.integration.test.ts tests/home-config.test.ts tests/process.test.ts tests/publisher-grants.test.ts tests/local-development-checkpoint-runner.test.ts --testTimeout=15000 --hookTimeout=15000",
    "checkpoint:local-dev:app": "node packages/cli/scripts/checkpoint-local-dev.mjs",
    "dev": "tsx packages/cli/src/cli.ts",
    "dev:ui": "npm run dev:ui --workspace=cordisx --",
    "predev": "npm run prepare:dev",
    "precheckpoint:local-dev:app": "npm run build --workspace=cordisx",
    "precheckpoint:local-dev": "npm run build --workspace=cordisx",
    "prepare": "npm run build --workspace=cordisx",
    "prepare:dev": "npm run prepare:dev --workspace=cordisx",
    "smoke": "node packages/cli/scripts/live-smoke.mjs",
    "smoke:desktop-agents": "node packages/cli/scripts/run-codex-desktop-agent-session-harness.mjs",
    "smoke:isolated-app": "node packages/cli/scripts/run-isolated-app-smoke.mjs",
    "test": "npm run build --workspace=@cordisx/schemastery-ui && vitest run --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000",
    "test:affected": "npm run build --workspace=@cordisx/schemastery-ui && vitest run --changed --passWithNoTests --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint:source": "eslint .",
    "lint": "eslint .",
    "lint:staged": "lint-staged --config .lintstagedrc.mjs",
    "prepare:sdk": "node scripts/prepare-sdk.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@cordisx/channel": "github:cordisx/plugin-channel#d426ec0a7a907746bc62317269a0ec5b3379adf9",
    "@cordisx/plugin-cli-proxy-api": "github:cordisx/plugin-cli-proxy-api#5857dac38a1d3d0f0a45b43150fe69b92321dab4",
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#f46dd21e15a949a26f05f89bf11dea339fc60c02",
    "@cordisx/schemastery-ui": "0.1.0-beta.2",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@oneworks/avatar": "1.0.0-rc.8",
    "@oneworks/avatar-react": "1.0.0-rc.8",
    "@shikitor/core": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "debug": "4.4.3",
    "es-module-lexer": "1.7.0",
    "esbuild": "0.28.2",
    "extend": "3.0.2",
    "intl-messageformat": "11.2.14",
    "lightningcss": "1.33.0",
    "luna-console": "1.3.6",
    "luna-data-grid": "1.6.5",
    "luna-dom-viewer": "1.8.4",
    "luna-object-viewer": "0.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "reicon": "1.2.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "style-to-js": "1.1.21",
    "swr": "2.5.1",
    "tar": "7.5.22",
    "tdesign-react": "1.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cordisx/eslint-config": "github:cordisx/cordisxmono#c63c2e8c2ba7e11502934a52ad2ce3734e804cdc",
    "@typescript-eslint/parser": "8.69.0",
    "dprint": "0.57.1",
    "eslint": "9.39.4",
    "lint-staged": "16.2.7"
  },
  "bundleDependencies": [
    "@cordisx/schemastery-ui",
    "@cordisx/channel",
    "@cordisx/plugin-cli-proxy-api"
  ]
}
