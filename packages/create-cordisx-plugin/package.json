{
  "name": "create-cordisx-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Create a minimal CordisX plugin project",
  "type": "module",
  "files": [
    "dist",
    "template"
  ],
  "bin": {
    "create-cordisx-plugin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
