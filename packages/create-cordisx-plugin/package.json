{
  "name": "create-cordisx-plugin",
  "version": "0.1.0-beta.2",
  "description": "Create standalone, workspace, or embedded CordisX plugin projects",
  "type": "module",
  "files": [
    "dist",
    "template",
    "README.md",
    "LICENSE",
    "CORDISX-INDEPENDENT-PLUGIN-EXCEPTION.md"
  ],
  "exports": {},
  "bin": {
    "create-cordisx-plugin": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build && npm test",
    "check:package": "node scripts/check-package-contents.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.node-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://cordisx.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordisx/cordisx.git",
    "directory": "packages/create-cordisx-plugin"
  },
  "bugs": {
    "url": "https://github.com/cordisx/cordisx/issues"
  },
  "keywords": [
    "cordisx",
    "create",
    "plugin",
    "scaffolding"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
