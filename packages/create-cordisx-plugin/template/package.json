{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A CordisX plugin",
  "type": "module",
  "main": "./dist/{{pluginId}}.js",
  "types": "./dist/{{pluginId}}.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node --test test/manifest.mjs",
    "dev": "cordisx dev ./src/{{pluginId}}.tsx",
    "dev:dry-run": "cordisx dev ./src/{{pluginId}}.tsx --dry-run",
    "test": "node --test test/manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "cordisx": "{{cordisxVersion}}",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
