{
  "name": "cordisx",
  "version": "0.1.0-beta.2",
  "description": "An experimental Cordis-powered UI plugin host for Codex Desktop",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CORDISX-INDEPENDENT-PLUGIN-EXCEPTION.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party"
  ],
  "bundledDependencies": [
    "@cordisx/schemastery-ui"
  ],
  "bin": {
    "cordisx": "dist/src/cli.js"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "default": "./dist/src/react.js"
    },
    "./react/jsx-runtime": {
      "types": "./dist/src/react-jsx-runtime.d.ts",
      "default": "./dist/src/react-jsx-runtime.js"
    },
    "./react/jsx-dev-runtime": {
      "types": "./dist/src/react-jsx-dev-runtime.d.ts",
      "default": "./dist/src/react-jsx-dev-runtime.js"
    },
    "./ui": {
      "types": "./dist/src/ui.d.ts",
      "default": "./dist/src/ui.js"
    }
  },
  "scripts": {
    "build": "npm run build --workspace=@cordisx/channel-runtime && npm run build --workspace=@cordisx/schemastery-ui && node scripts/prepare-bundled-schemastery-ui.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "check": "npm run typecheck",
    "check:package": "node scripts/check-package-contents.mjs",
    "dev": "tsx src/cli.ts",
    "dev:ui": "tsx src/playground/cli.ts",
    "generate:brand-animation": "node scripts/generate-animated-brand-marks.mjs",
    "generate:contributors": "node scripts/generate-contributors.mjs",
    "predev": "npm run prepare:dev",
    "prepare:dev": "npm run build",
    "prepack": "npm run build",
    "smoke": "node scripts/live-smoke.mjs",
    "typecheck": "npm run build --workspace=@cordisx/channel-runtime && npm run build --workspace=@cordisx/schemastery-ui && node scripts/prepare-bundled-schemastery-ui.mjs && tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://cordisx.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordisx/cordisx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cordisx/cordisx/issues"
  },
  "keywords": [
    "codex",
    "cordis",
    "plugins"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "dependencies": {
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#90a1ea6a27465ba996bae4cf524ec2cd61865828",
    "@cordisx/schemastery-ui": "0.1.0-beta.2",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@oneworks/avatar": "1.0.0-rc.8",
    "@oneworks/avatar-react": "1.0.0-rc.8",
    "@shikitor/core": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "intl-messageformat": "11.2.14",
    "luna-console": "1.3.6",
    "luna-data-grid": "1.6.5",
    "luna-dom-viewer": "1.8.4",
    "luna-object-viewer": "0.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "reicon": "1.2.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "swr": "2.5.1",
    "tar": "7.5.22",
    "tdesign-react": "1.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cordisx/channel-runtime": "file:../channel-runtime",
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#90a1ea6a27465ba996bae4cf524ec2cd61865828",
    "@types/node": "^22.18.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "vitest": "^3.2.4"
  },
  "bundleDependencies": [
    "@cordisx/schemastery-ui"
  ]
}
