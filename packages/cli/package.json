{
  "name": "cordisx",
  "version": "0.1.0-beta.0",
  "description": "An experimental Cordis-powered UI plugin host for Codex Desktop",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CORDISX-INDEPENDENT-PLUGIN-EXCEPTION.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party"
  ],
  "bin": {
    "cordisx": "dist/src/cli.js"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    }
  },
  "scripts": {
    "build": "npm run build --workspace=@cordisx/channel-runtime && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "check": "npm run typecheck",
    "check:package": "node scripts/check-package-contents.mjs",
    "dev": "tsx src/cli.ts",
    "dev:ui": "tsx src/playground/cli.ts",
    "prepack": "npm run build",
    "smoke": "node scripts/live-smoke.mjs",
    "typecheck": "npm run build --workspace=@cordisx/channel-runtime && tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://cordisx.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordisx/cordisx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cordisx/cordisx/issues"
  },
  "keywords": [
    "codex",
    "cordis",
    "plugins"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@material-symbols/svg-400": "0.46.0",
    "esbuild": "^0.25.9",
    "intl-messageformat": "11.2.14",
    "luna-console": "1.3.6",
    "luna-data-grid": "1.6.5",
    "luna-dom-viewer": "1.8.4",
    "luna-object-viewer": "0.3.2",
    "tar": "7.5.22",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cordisx/channel-runtime": "file:../channel-runtime",
    "@types/node": "^22.18.1",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
